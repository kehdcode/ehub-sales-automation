# ─── Security ───────────────────────────────────────────────
# Shared secret every webhook caller must send (header x-ehub-secret or ?secret=)
WEBHOOK_SECRET=change-me-long-random-string
# Vercel sends "Authorization: Bearer <CRON_SECRET>" to cron routes automatically
CRON_SECRET=change-me-another-long-random-string
# Public URL of this deployment (used in approval links)
APP_URL=https://your-project.vercel.app

# ─── Behaviour ──────────────────────────────────────────────
TIMEZONE=Africa/Lagos
# true = log emails instead of sending (use while testing)
DRY_RUN=true
# Leads scoring at or above this get flagged "hot" to the team
HOT_LEAD_SCORE=70
# Days to wait before follow-up email 1, 2, 3, 4, then before moving to nurture
FOLLOWUP_INTERVAL_DAYS=3,4,5,7,7
# Days after a LOST decision before the win-back date
WINBACK_DAYS=90

# ─── HubSpot (Private App token) ────────────────────────────
# Scopes: crm.objects.contacts.read/write, crm.objects.deals.read/write,
#         crm.schemas.contacts.write, crm.schemas.deals.write
HUBSPOT_TOKEN=pat-xxx
HUBSPOT_PIPELINE_ID=default
# Your portal (hub) ID — used for links to deals in team emails
HUBSPOT_PORTAL_ID=
# Optional: map automation stages to your HubSpot deal-stage IDs (JSON)
# HUBSPOT_STAGE_MAP={"new":"appointmentscheduled","discovery_booked":"qualifiedtobuy","proposal_approved":"presentationscheduled","follow_up":"decisionmakerboughtin","won":"closedwon","lost":"closedlost"}

# ─── AI (Anthropic) ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-5-5
# Only if your key isn't scoped to a workspace (Console → Settings → Workspaces → copy the ID)
ANTHROPIC_WORKSPACE_ID=

# ─── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=re_xxx
EMAIL_FROM=Ehub <hello@yourdomain.com>
EMAIL_REPLY_TO=hello@yourdomain.com
# Comma-separated team inboxes for approvals, hot leads, wins
TEAM_EMAILS=you@yourdomain.com
# Optional: HubSpot BCC address so every prospect email shows on the contact timeline
HUBSPOT_BCC=
SENDER_NAME=Kehinde
COMPANY_NAME=Ehub

# ─── Google Docs / Drive (proposals + client folders) ───────
# Option A (personal Gmail): OAuth client + refresh token
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Option B (Workspace + Shared Drive): service account JSON (raw or base64)
GOOGLE_SERVICE_ACCOUNT_JSON=
PROPOSAL_TEMPLATE_DOC_ID=
PROPOSALS_FOLDER_ID=
CLIENTS_FOLDER_ID=
# true = anyone with the link can view proposal PDFs
PROPOSAL_LINK_PUBLIC=true

# ─── Meta Lead Ads (optional) ───────────────────────────────
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
